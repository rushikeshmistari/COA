#include <stdio.h>

int main()
{
    int M, Q, A = 0, Q1 = 0, count = 8;
    int i, q0, product;

    printf("Enter multiplicand M: ");
    scanf("%d", &M);
    printf("Enter multiplier Q: ");
    scanf("%d", &Q);

    Q = Q & 0xFF;           

    for (i = 0; i < count; i++)
    {
        q0 = Q & 1;            

        if (q0 == 0 && Q1 == 1)
            A = A + M;          
        else if (q0 == 1 && Q1 == 0)
            A = A - M;           
                                 

        Q1 = Q & 1;
        Q  = (Q >> 1) | ((A & 1) << 7);
        A  = A >> 1;              
    }

    product = (A << 8) | (Q & 0xFF);
    if (product > 32767)          
        product = product - 65536;

    printf("Product = %d\n", product);
    return 0;
}
