include 'emu8086.inc'
.stack 100h
.model small
.data
    src db 11h,22h,33h,44h,55h 
    dst db 5 dup(0)             
    n   equ 5                  
.code
    main proc
        mov ax,@data          
        mov ds,ax
        mov es,ax              
        print 'Source before      : '
        lea si,src
        call show_block
        printn ''
        print 'Destination before : '
        lea si,dst
        call show_block
        printn ''

        lea si,src             
        lea di,dst              
        mov cx,n                
        cld                     
        rep movsb            
        printn ''
        print 'Source after       : '
        lea si,src
        call show_block
        printn ''
        print 'Destination after  : '
        lea si,dst
        call show_block
        printn ''

        mov ah,4ch           
        int 21h
    main endp

    show_block proc
        push ax
        push cx
        push dx
        push si
        mov cx,n
    next_byte:
        mov al,[si]
        mov dh,al
        push cx
        mov cl,4
        shr al,cl             
        pop cx
        call hex_digit
        mov al,dh
        and al,0Fh         
        call hex_digit
        mov dl,'H'
        mov ah,02h
        int 21h
        mov dl,' '
        mov ah,02h
        int 21h
        inc si
        loop next_byte
        pop si
        pop dx
        pop cx
        pop ax
        ret
    show_block endp

    hex_digit proc
        cmp al,9
        jbe is_number
        add al,7
    is_number:
        add al,48
        mov dl,al
        mov ah,02h
        int 21h
        ret
    hex_digit endp

end main
