include 'emu8086.inc'
.stack 100h
.model small
.data
    arr db 56,23,91,14       
    n   equ 4              
.code
    main proc
        mov ax,@data          
        mov ds,ax

        print 'Original array: '
        call show_array
        printn ''

        mov cx,n-1       

    outer:
        lea si,arr         
        mov dx,cx            

    inner:
        mov al,[si]           
        mov bl,[si+1]
        cmp al,bl
        jbe no_swap          
        mov [si],bl           
        mov [si+1],al
    no_swap:
        inc si             
        dec dx
        jnz inner

        loop outer            

        print 'Sorted array  : '
        call show_array
        printn ''

        mov ah,4ch           
        int 21h
    main endp

    show_array proc
        push ax
        push cx
        push si
        lea si,arr
        mov cx,n
    next_item:
        mov al,[si]
        mov ah,0
        call print_num         
        print ' '
        inc si
        loop next_item
        pop si
        pop cx
        pop ax
        ret
    show_array endp

    define_print_num
    define_print_num_uns

end main
