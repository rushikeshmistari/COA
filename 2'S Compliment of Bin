#include <stdio.h>
#include <string.h>
int main() {
    char bin[50];
    int i, len;
    printf("Enter a binary number: ");
    scanf("%s", bin);
    len = strlen(bin);
    for(i = len - 1; i >= 0; i--) {
        if(bin[i] == '1'){
            break;
        }
    }
    for(i = i - 1; i >= 0; i--) {
        if(bin[i] == '1'){
            bin[i] = '0';
        }
        else{
            bin[i] = '1';
        }
    }
    printf("2's Complement = %s", bin);
    return 0;
}
