#include <stdio.h>
void printBinary(int num){
    for (int i = 15; i >= 0; i--){
        int bit = (num >> i) & 1;
        printf("%d", bit);
    }
    printf("\n");
}
int main(){
    int dec, hex;
    printf("Enter a decimal number: ");
    scanf("%d", &dec);
    printf("Enter a hexadecimal number: ");
    scanf("%x", &hex);
    printf("\n--- Binary Equivalents ---\n");
    printf("Decimal %d in Binary: ", dec);
    printBinary(dec);
    printf("Hexadecimal %X in Binary: ", hex);
    printBinary(hex);
return 0;
}
